{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "es5",
  "bracketSpacing": true,
  "tabWidth": 4,
  "printWidth": 120,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "sortPackageJson": false,
  "overrides": [
    {
      "files": ["*.{json,jsonc,yml,yaml,css,html}"],
      "options": {
        "tabWidth": 2
      }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", "patches", "pnpm-lock.yaml"]
}
